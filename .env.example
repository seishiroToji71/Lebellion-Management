DB_URL=jdbc:postgresql://localhost:5432/lebellion
DB_USERNAME=lebellion
DB_PASSWORD=lebellion
PORT=8080

# Auth secrets — generate strong random values in prod, never commit real ones.
# JWT_SECRET must be >= 32 bytes (HS256).
JWT_SECRET=change-me-to-a-32-byte-plus-random-secret
INVITE_HMAC_SECRET=change-me-to-a-random-secret
PASSWORD_RESET_HMAC_SECRET=change-me-to-a-random-secret
